{

  "$schema": "./kits/geostat-kit/manifest.schema.json",

  "version": 2,

  "package": "kits/geostat-kit",

  "secrets": "ops/config",

  "features": {

    "gcpCredentials": true

  },

  "compose": {

    "catalog": "ops/compose/catalog.json",

    "syncModules": "apps/backend/ops.modules"

  },

  "stack": {

    "composeDir": "ops/compose/stack",

    "composeModules": ["chat-api", "retrieval", "ingestion", "frontend"],

    "deployBaseSecretsModule": "chat-api",

    "networkName": "geostat-chat-ai-net",

    "infraComposeDir": "ops/compose/infra",

    "infra": {

      "services": ["postgres", "redis", "qdrant", "rabbitmq"]

    }

  },

  "cli": {

    "aliases": {

      "fe": "frontend",

      "be": "chat-api",

      "chat": "chat-api",

      "ret": "retrieval",

      "ing": "ingestion"

    }

  },

  "modules": {

    "chat-api": {

      "role": "api",

      "type": "java-boot",

      "path": "apps/backend",

      "secretsModule": "backend",

      "target": "backend",

      "compose": {
        "embeddedWorker": false
      },

      "debug": {

        "java": {

          "mainClass": "com.geostat.chat.ChatApplication",

          "projectName": "geostat-chat-ai"

        }

      },

      "hybrid": {

        "springProfiles": "local",
        "preferJar": true,
        "bootJar": "apps/backend/build/libs/geostat-chat-ai-2.0.0-SNAPSHOT.jar"

      },

      "configGen": {

        "mode": "env-profiles"

      },

      "spring": {

        "applicationName": "geostat-chat-ai",

        "defaultProfile": "local",

        "portEnv": "API_PORT"

      },

      "credentials": [

        {

          "file": "google-credentials.json",

          "mount": "/app/google-credentials.json",

          "envVar": "GOOGLE_APPLICATION_CREDENTIALS"

        }

      ]

    },

    "frontend": {

      "role": "ui",

      "type": "node-vite",

      "path": "apps/frontend",

      "secretsModule": "frontend",

      "target": "frontend",

      "debug": {

        "npmScript": "dev"

      }

    },

    "retrieval": {

      "role": "api",

      "type": "java-boot",

      "path": "apps/retrieval-service",

      "secretsModule": "retrieval",

      "target": "retrieval",

      "debug": {

        "java": {

          "mainClass": "com.geostat.retrieval.RetrievalApplication",

          "projectName": "retrieval-service"

        }

      },

      "hybrid": {

        "gradleWrapper": "apps/backend/gradlew.bat",
        "preferJar": true,
        "bootJar": "apps/retrieval-service/build/libs/retrieval-service-0.1.0-SNAPSHOT.jar"

      },

        "portEnv": "RETRIEVAL_PORT"

      },

      "configGen": {

        "mode": "simple"

      }

    },

    "ingestion": {

      "role": "worker",

      "type": "java-boot",

      "path": "apps/ingestion-service",

      "secretsModule": "ingestion",

      "target": "ingestion",

      "debug": {

        "java": {

          "mainClass": "com.geostat.ingestion.IngestionApplication",

          "projectName": "ingestion-service"

        }

      },

      "hybrid": {

        "gradleWrapper": "apps/backend/gradlew.bat",
        "preferJar": true,
        "bootJar": "apps/ingestion-service/build/libs/ingestion-service-0.1.0-SNAPSHOT.jar"

      },

      "datastores": {

        "postgres": { "schema": "ingestion", "database": "geostat", "flyway": true },

        "rabbitmq": { "optional": true },

        "qdrant": { "optional": true },

        "events": { "enabledEnv": "INGESTION_EVENTS_ENABLED" }

      },

      "spring": {

        "applicationName": "ingestion-service",

        "defaultProfile": "nodb",

        "portEnv": "INGESTION_PORT",

        "profileGroups": {

          "hybrid": ["db", "hybrid-env"],

          "docker": ["db", "docker-env"]

        }

      }

    }

  },

  "adapters": {

    "gcp": {

      "credentialsFile": "google-credentials.json",

      "containerMount": "/app/google-credentials.json"

    },

    "nginx": {

      "template": "apps/frontend/nginx.conf.template",

      "output": "apps/frontend/nginx.conf",

      "envExample": "ops/config/frontend/nginx.env.example",

      "env": "ops/config/frontend/nginx.env"

    },

    "embed": {

      "envExample": "ops/config/frontend/embed.env.example"

    }

  },

  "ci": {

    "integration": "ops/ci/integration-stack.sh",

    "prepareEnv": "kits/geostat-kit/ci/prepare-integration-env.sh",

    "waitHealth": "kits/geostat-kit/ci/wait-health.sh",

    "waitStackHealth": "kits/geostat-kit/ci/wait-stack-health.sh",

    "ragSmoke": "ops/ci/rag-pipeline-smoke.sh",

    "chatCatalogRagSmoke": "ops/ci/chat-catalog-rag-smoke.ps1",

    "chatRagE2eSmoke": "ops/ci/chat-rag-e2e-smoke.sh",

    "verifyServicesProd": "ops/ci/verify-services-prod.sh",

    "corpusQualityAudit": "ops/ci/corpus-quality-audit.sh",

    "ragEvalSmoke": "ops/ci/rag-eval-smoke.ps1",

    "ragLocalePipeline": "ops/ci/rag-locale-pipeline.ps1",

    "healthModules": ["chat-api", "retrieval", "ingestion"]

  },

  "vscode": {

    "folder": ".vscode",

    "geostatScript": "tools/geostat.ps1"

  }

}

