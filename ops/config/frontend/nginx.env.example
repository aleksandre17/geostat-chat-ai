# Nginx CSP frame-ancestors (space-separated URLs, no quotes)
# Copy to nginx.env (gitignored) and run: tools/geostat nginx-gen
#
# Production example:
# NGINX_FRAME_ANCESTORS=https://chat.geostat.ge https://www.geostat.ge https://your-host:5177
#
# Local / lab default:
NGINX_FRAME_ANCESTORS='self' http://localhost:5173 http://localhost:5174 http://localhost:5177 http://127.0.0.1:5177
