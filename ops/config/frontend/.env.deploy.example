# Frontend deploy — copy to .env.deploy (gitignored)
# Shared SSH/project: secrets/deploy.env (DEPLOY_SERVER, DEPLOY_PROJECT)
#
# DEPLOY_LAYOUT=structured  →  static/ (fe deploy dist) + compose/dev|prod/
# DEPLOY_PATH_MODE=base       →  DEPLOY_PATH is module base, not per-container dir

DEPLOY_HOST_PORT=5177
DEPLOY_PATH=/home/administrator/geostat/frontend
DEPLOY_LAYOUT=structured
DEPLOY_PATH_MODE=base

# DEPLOY_PATH_MODE=full  — use DEPLOY_PATH as exact service dir (no /static/ suffix)
