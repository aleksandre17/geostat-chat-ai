# secrets/backend — copy to .env.dev and .env.prod (see secrets/.env.example)

API_PORT=8090
WORKER_PORT=8091
# Docker internal DNS — names from manifest + compose-gen (geostat compose-names):
API_INTERNAL_URL=http://geostat-chat-ai-api:8090
# Ingestion worker (not apps/backend/worker): geostat-chat-ai-ingestion:8093
# RETRIEVAL_BASE_URL=http://geostat-chat-ai-retrieval:8092
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEOSTAT_SEARCH_API_KEY=
GEOSTAT_SEARCH_CX_ID=

# Hybrid dev (infra remote + tunnel) — see ops/config/infra/.env.example
# INFRA_HOST=127.0.0.1
RETRIEVAL_BASE_URL=http://localhost:8092
RETRIEVAL_ENABLED=false
RETRIEVAL_DEFAULT_CORPUS=geostat-portal
# SPRING_PROFILES_ACTIVE=dev,hybrid
