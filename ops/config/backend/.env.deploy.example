# Backend deploy layout — copy to .env.deploy (gitignored)
# Shared SSH/project: secrets/deploy.env (DEPLOY_SERVER, DEPLOY_PROJECT)
#
# DEPLOY_LAYOUT=structured  →  runtime/ (be deploy) + workspace/ (be dev)
# DEPLOY_LAYOUT=flat       →  legacy: {DEPLOY_PATH}/{container}/ only
# Without this file, deploy defaults to flat paths.

DEPLOY_PATH=/home/administrator/geostat/backend
DEPLOY_LAYOUT=structured
DEPLOY_PATH_MODE=base

# DEPLOY_PATH_MODE=full  — use DEPLOY_PATH as exact service dir (no /runtime/ suffix)

# Optional overrides (usually in .env.dev / .env.prod):
# API_PORT=8090
