# Infra remote deploy — copy to .env.deploy (gitignored)
# Shared SSH/project: ops/config/deploy.env (DEPLOY_SERVER, DEPLOY_PROJECT)
#
# Shared server root (DEPLOY_PROJECT=geostat in ops/config/deploy.env):
#   /home/administrator/geostat/
#     frontend/   ← shared base (all consumers)
#     backend/    ← shared base
#     infra/
#       <INFRA_SLUG>/   ← THIS consumer's Postgres/Redis/Qdrant (one stack per repo)
#         compose/
#         .env.runtime
#
# INFRA_SLUG = repo folder name (e.g. geostat-chat-ai, myshop). Must match .env.dev INFRA_SLUG.
# Fallback if DEPLOY_PATH empty: {DEPLOY_SERVER_BASE}/{DEPLOY_PROJECT}/infra/{INFRA_SLUG}
#
# Plan: docs/plan/SERVER-DEPLOY-LAYOUT.md

INFRA_SLUG=geostat-chat-ai
DEPLOY_PATH=/home/administrator/geostat/infra/geostat-chat-ai
