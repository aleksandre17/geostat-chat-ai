# ops/config/infra — copy to .env.dev and .env.prod (gitignored)
# Used by: ops/compose/infra/docker-compose.yml (--env-file)
# Hybrid apps on Windows: INFRA_HOST=127.0.0.1 after `geostat infra tunnel`
#
# Per-project infra on shared server: geostat/infra/<INFRA_SLUG>/ (see SERVER-DEPLOY-LAYOUT.md)
# Second project on same host: change INFRA_* + ports (e.g. 5433, 6380, 6335).

# Which stores run: geostat.ops.json → stack.infra.services (not env toggles)

# --- Identity (unique per consumer repo on one server) ---
INFRA_SLUG=geostat-chat-ai
INFRA_PREFIX=geostat-chat-ai
INFRA_COMPOSE_PROJECT=geostat-chat-ai-infra

# --- Docker network (must match this repo's app compose / catalog) ---
DOCKER_NETWORK=geostat-chat-ai-net

# --- Host ports (127.0.0.1 bind) — unique per INFRA_SLUG on shared server ---
# geostat-chat-ai: 5432 / 6379 / 6333 | myshop: 5433 / 6380 / 6335 | next: +1 / +1 / +2
# --- Postgres ---
POSTGRES_PORT=5432
POSTGRES_DB=geostat
POSTGRES_USER=geostat
POSTGRES_PASSWORD=change-me-in-env-dev

# JDBC for Spring (hybrid / local apps — not used by compose itself)
SPRING_DATASOURCE_URL=jdbc:postgresql://${INFRA_HOST:-127.0.0.1}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-geostat}

# --- Redis ---
REDIS_PORT=6379
REDIS_AOF=yes
SPRING_DATA_REDIS_HOST=${INFRA_HOST:-127.0.0.1}
SPRING_DATA_REDIS_PORT=${REDIS_PORT:-6379}

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://${INFRA_HOST:-127.0.0.1}:${QDRANT_HTTP_PORT:-6333}

# --- RabbitMQ (P5 async events) ---
RABBITMQ_PORT=5672
RABBITMQ_USER=geostat
RABBITMQ_PASSWORD=change-me-in-env-dev
SPRING_RABBITMQ_HOST=${INFRA_HOST:-127.0.0.1}
SPRING_RABBITMQ_PORT=${RABBITMQ_PORT:-5672}

# --- Hybrid (apps on host, infra in Docker on server) ---
INFRA_HOST=127.0.0.1
