# =============================================================================
#  GeoStat Chat Bot — Environment contract (ერთიანი ხელწერა)
#
#  Index (who reads what): docs/CONFIG.md
#
#  ყოველი მოდული:
#    secrets/<module>/.env.dev     — ლოკალური განვითარება
#    secrets/<module>/.env.prod    — production / prod build
#    secrets/<module>/.env.deploy    — მოდულის deploy (path, port)
#
#  საერთო:
#    secrets/deploy.env            — SSH (DEPLOY_SERVER)
#
#  Backend only:
#    secrets/backend/google-credentials.json
# =============================================================================

# --- Shared (deploy.env) ---
# DEPLOY_SERVER=user@host
# DEPLOY_SSH_IDENTITY_FILE=secrets/ssh/id_ed25519   # optional — see secrets/ssh/README.md
# DEPLOY_SSH_CONFIG_FILE=secrets/ssh/config

# --- Frontend (.env.dev / .env.prod) ---
# VITE_API_URL=http://localhost:8090

# --- Frontend (.env.deploy) ---
# DEPLOY_HOST_PORT=5177
# DEPLOY_PATH=/home/user/geostat/frontend

# --- Backend (.env.dev / .env.prod) ---
# API_PORT=8090
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# GEOSTAT_SEARCH_API_KEY=
# GEOSTAT_SEARCH_CX_ID=

# --- Ingestion service (secrets/ingestion/.env.dev / .env.prod) ---
# INGESTION_PORT=8093
# INGESTION_DEFAULT_CORPUS=geostat-portal
# INGESTION_PARSE_CONFIG_DIR=ops/config/corpus
# INGESTION_PARSE_PROFILE_ENABLED=true

# Crawl orchestration
# CRAWL_CONCURRENT_CORPORA=2
# CRAWL_TIMEOUT_HOURS=6
# CRAWL_SEED_URL=https://www.geostat.ge/ka

# Fetch mode — static HTTP (crawler4j) vs headless browser (Playwright for SPAs)
# INGESTION_PLAYWRIGHT_ENABLED=false
# INGESTION_PLAYWRIGHT_TIMEOUT_MS=30000

# Pipeline toggles
# INGESTION_INDEXING_ENABLED=true
# INGESTION_INDEX_VERSION=v1
# INGESTION_EVENTS_ENABLED=false
# INGESTION_ENRICHMENT_ENABLED=false
# INGESTION_AGGREGATION_ENABLED=false
# INGESTION_SCHEDULER_ENABLED=false
# INGESTION_SCHEDULER_DELAY_MS=3600000
# INGESTION_FRESHNESS_ENABLED=true
# INGESTION_NAMED_VECTORS_ENABLED=false

# Qdrant vector store (shared with retrieval-service)
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=

# Embeddings — ingestion + retrieval must use the same provider/model
# EMBEDDING_PROVIDER=hash-v1
# EMBEDDING_MODEL_ID=gemini/text-embedding-004
# EMBEDDING_VECTOR_SIZE=768
# GEMINI_EMBED_MODEL=gemini-embedding-001
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Retrieval service (secrets/retrieval/.env.dev / .env.prod) ---
# RETRIEVAL_DEFAULT_CORPUS=geostat-portal
