# =============================================================================
#  GeoStat Chat Bot — Environment contract (ერთიანი ხელწერა)
#
#  Index (who reads what): docs/CONFIG.md
#
#  ყოველი მოდული:
#    secrets/<module>/.env.dev     — ლოკალური განვითარება
#    secrets/<module>/.env.prod    — production / prod build
#    secrets/<module>/.env.deploy    — მოდულის deploy (path, port)
#
#  საერთო:
#    secrets/deploy.env            — SSH (DEPLOY_SERVER)
#
#  Backend only:
#    secrets/backend/google-credentials.json
# =============================================================================

# --- Shared (deploy.env) ---
# DEPLOY_SERVER=user@host
# DEPLOY_SSH_IDENTITY_FILE=secrets/ssh/id_ed25519   # optional — see secrets/ssh/README.md
# DEPLOY_SSH_CONFIG_FILE=secrets/ssh/config

# --- Frontend (.env.dev / .env.prod) ---
# VITE_API_URL=http://localhost:8090

# --- Frontend (.env.deploy) ---
# DEPLOY_HOST_PORT=5177
# DEPLOY_PATH=/home/user/geostat/frontend

# --- Backend (.env.dev / .env.prod) ---
# API_PORT=8090
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# GEOSTAT_SEARCH_API_KEY=
# GEOSTAT_SEARCH_CX_ID=
