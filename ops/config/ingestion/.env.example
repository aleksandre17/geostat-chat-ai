INGESTION_PORT=8093

# Crawl (future jobs API)
# CRAWL_SEED_URL=https://www.geostat.ge/ka

# Postgres — schema ingestion (owner: ingestion-service, Q-14)
# Hybrid: geostat infra tunnel + profiles below
# Docker stack: profile docker (hostname postgres on geostat-chat-ai-net)
SPRING_PROFILES_ACTIVE=dev,hybrid
SPRING_DATASOURCE_URL=jdbc:postgresql://${INFRA_HOST:-127.0.0.1}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-geostat}?currentSchema=ingestion
POSTGRES_USER=geostat
POSTGRES_PASSWORD=geostat-dev-change-me
POSTGRES_DB=geostat
POSTGRES_PORT=5432
INFRA_HOST=127.0.0.1

# Qdrant (via geostat infra tunnel)
QDRANT_URL=http://${INFRA_HOST:-127.0.0.1}:${QDRANT_HTTP_PORT:-6333}
QDRANT_GRPC_PORT=6334
INGESTION_INDEXING_ENABLED=true

# P5 — async document index via RabbitMQ (false = sync in-process, no broker required)
INGESTION_EVENTS_ENABLED=false
RABBITMQ_HOST=${INFRA_HOST:-127.0.0.1}
RABBITMQ_PORT=5672
RABBITMQ_USER=geostat
RABBITMQ_PASSWORD=geostat-dev-change-me

# Embeddings — ingestion + retrieval must use the same provider/model
EMBEDDING_PROVIDER=hash-v1
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=text-embedding-004
# EMBEDDING_VECTOR_SIZE=768
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
