# Ingestion deploy layout — copy to .env.deploy (gitignored)
# Shared SSH/project: ops/config/deploy.env (DEPLOY_SERVER, DEPLOY_PROJECT)
#
# Same structured backend base as chat-api (runtime/<container>/)
# Optional: omit DEPLOY_PATH here — manifest stack.deployBaseSecretsModule inherits backend/.env.deploy
DEPLOY_PATH=/home/administrator/geostat/backend
DEPLOY_LAYOUT=structured
DEPLOY_PATH_MODE=base
