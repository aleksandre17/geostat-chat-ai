# --- Legacy compose identity (existing servers) ---
# Merge into secrets/deploy.env, then: tools/geostat compose-gen
#
# Remote path (DEPLOY_PROJECT) is independent of container names.

COMPOSE_API_SERVICE=geostat-chat-api
COMPOSE_APP_SERVICE=geostat-chat-app
COMPOSE_WORKER_SERVICE=geostat-chat-worker
DOCKER_NETWORK=geostat-net
# Optional if compose project name differed:
# COMPOSE_PROJECT_NAME=geostat-chat-ai

# Keep your real SSH target only in deploy.env (not in repo):
# DEPLOY_SERVER=user@your-server
# DEPLOY_PROJECT=geostat
