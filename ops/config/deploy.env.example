# Shared deploy / compose identity — copy to deploy.env (gitignored)
# Real DEPLOY_SERVER must live ONLY here — never commit deploy.env.
# See: docs/ENVIRONMENT.md | secrets/profiles/

# --- SSH (required for remote deploy/manage) ---
# Connection target — user@host OR Host alias from secrets/ssh/config (see secrets/ssh/README.md)
DEPLOY_SERVER=user@YOUR_SERVER

# Optional project-local SSH (never commit private keys):
# DEPLOY_SSH_IDENTITY_FILE=secrets/ssh/id_ed25519
# DEPLOY_SSH_CONFIG_FILE=secrets/ssh/config
# DEPLOY_SSH_OPTIONS=-o StrictHostKeyChecking=accept-new
# Remote tree: $DEPLOY_SERVER_BASE/$DEPLOY_PROJECT/{backend|frontend}/...
# DEPLOY_SERVER_BASE=/home/user
DEPLOY_PROJECT=

# --- Compose identity ---
# Service names come from geostat.ops.json modules (compose-gen). Set only:
# COMPOSE_PROJECT_NAME=my-app
# DOCKER_NETWORK=my-app-net
#
# Legacy override (existing server container names) — merge profiles/legacy-server.env.example:
# COMPOSE_API_SERVICE=legacy-api
# COMPOSE_APP_SERVICE=legacy-app
# COMPOSE_WORKER_SERVICE=legacy-worker
# Then compose-gen. For Docker DNS in backend .env use the generated api service name, e.g.:
# API_INTERNAL_URL=http://geostat-chat-ai-api:8090

# --- Ports (local / compose) ---
# API_PORT=8090
# WORKER_PORT=8091
# DEPLOY_HOST_PORT=5177
# APP_DEV_CONTAINER_PORT=5177

# --- Build / infra ---
# OPS_BUILD_TMP_PREFIX=ops-build
# OPS_MONOREPO_ROOT=/absolute/path   # only if repo is not discovered via secrets/
