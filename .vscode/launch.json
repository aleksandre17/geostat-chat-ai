{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "backend: Spring Boot",
      "type": "java",
      "request": "launch",
      "mainClass": "com.geostat.chat.ChatApplication",
      "cwd": "${workspaceFolder}/apps/backend",
      "projectName": "geostat-chat-ai",
      "envFile": "${workspaceFolder}/ops/config/backend/.env.dev",
      "env": {
        "SPRING_PROFILES_ACTIVE": "local"
      }
    },
    {
      "name": "frontend: npm run dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/frontend"
    },
    {
      "name": "retrieval: Spring Boot",
      "type": "java",
      "request": "launch",
      "mainClass": "com.geostat.retrieval.RetrievalApplication",
      "cwd": "${workspaceFolder}/apps/retrieval-service",
      "projectName": "retrieval-service",
      "envFile": "${workspaceFolder}/ops/config/retrieval/.env.dev"
    },
    {
      "name": "ingestion: Spring Boot",
      "type": "java",
      "request": "launch",
      "mainClass": "com.geostat.ingestion.IngestionApplication",
      "cwd": "${workspaceFolder}/apps/ingestion-service",
      "projectName": "ingestion-service",
      "envFile": "${workspaceFolder}/ops/config/ingestion/.env.dev"
    },
    {
      "name": "geostat: stack (compose dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/geostat.ps1\" stack up -d --build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "geostat: be check",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/geostat.ps1\" be check",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "geostat: fe check",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/geostat.ps1\" fe check",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "geostat: ing check",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/geostat.ps1\" ing check",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "geostat: ret check",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/geostat.ps1\" ret check",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "geostat: ui check",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/geostat.ps1\" ui check",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "geostat: worker check",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/geostat.ps1\" worker check",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (local)",
      "configurations": [
        "backend: Spring Boot",
        "frontend: npm run dev"
      ],
      "stopAll": true
    },
    {
      "name": "Hybrid: infra tunnel + API + UI",
      "configurations": [
        "backend: Spring Boot",
        "frontend: npm run dev"
      ],
      "preLaunchTask": "geostat: infra tunnel",
      "stopAll": true
    }
  ]
}
